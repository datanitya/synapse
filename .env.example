# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://synapse:synapse_password@127.0.0.1:5433/synapse_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="http://localhost:3001/auth/linkedin/callback"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="replace_with_32+_char_random_string"
JWT_EXPIRY="7d"
JWT_REFRESH_SECRET="replace_with_different_32+_char_random_string"
JWT_REFRESH_EXPIRY="30d"

# ─── Encryption (for LinkedIn token storage at rest) ──────────────────────────
AUTH_ENCRYPTION_KEY="replace_with_32_byte_hex_string"

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Switch provider for ALL AI calls (generation + categorization): gemini | claude | openai
AI_PROVIDER="gemini"

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.0-flash-lite"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL_GENERATION="gpt-4o-mini"
OPENAI_MODEL_CATEGORIZATION="gpt-4o-mini"

# ─── Cloudinary (image storage) ──────────────────────────────────────────────
# Free tier at cloudinary.com — get from Dashboard > API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="SYNAPSE <noreply@synapse.app>"

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_PORT="3001"
WEB_PORT="3000"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Get from: https://dashboard.razorpay.com/app/webhooks (set webhook URL to /api/billing/webhook)
RAZORPAY_WEBHOOK_SECRET=""

# ─── Analytics (PostHog) ──────────────────────────────────────────────────────
# Frontend key (browser-side events)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
# Server key (server-side events — draft_generated, draft_published, trend_saved, plan_upgraded)
POSTHOG_API_KEY=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# International payments (alternative to Razorpay — both can coexist)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Get from: https://dashboard.stripe.com/webhooks (endpoint: /api/billing/stripe/webhook)
STRIPE_WEBHOOK_SECRET=""

# Note: JWT_SECRET above is also read by apps/web/middleware.ts (server-side Edge Runtime)
# to verify JWT signatures. It must match exactly.
